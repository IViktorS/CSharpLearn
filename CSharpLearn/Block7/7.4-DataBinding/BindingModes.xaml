<Window
    x:Class="CSharpLearn.Block7.BindingModes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="7.4 Биндинг"
    Width="760"
    Height="600">

    <!--
        ТЕМА 7.4 — Data Binding: режимы и триггеры
        
        Правила прежние: сначала впиши ПРЕДСКАЗАНИЕ, потом запускай.
        Запуск: dotnet run, проект CSharpLearn, аргумент 7.4
        (точная команда есть в 7.4-DataBinding.md)
        
        Задача 1 — написать биндинги самому, задачи 2 и 3 — предсказания.
        
        Кнопки в задачах 2 и 3 подключены в BindingModes.xaml.cs.
        Механизм событий — Блок 3; считай, что нажатие кнопки просто
        вызывает одноимённый метод. Чёрный ящик.
    -->

    <TabControl>

        <!--
            ═══ ЗАДАЧА 1: откуда ещё может взяться источник ═════════════════
            Ниже ползунок Volume и три TextBlock с пустым текстом.
            Замени Text="" в каждом на биндинг:
            
            (а) SliderValue — значение ползунка Volume;
            (б) OwnWidth    — фактическая ширина этого же TextBlock
            (свойство ActualWidth);
            (в) WindowTitle — заголовок окна (свойство Title у Window).
            
            Ни строчки кода в .xaml.cs для этого не нужно. DataContext
            здесь не задан вообще: источник каждый раз указывается в
            самом биндинге.
            
            ПРЕДСКАЗАНИЕ (1) двигаешь ползунок — меняется ли (а)? Почему,
            если никакого кода нет: Потому что мы привязались к свойству слайдера Value, у которого по умолчанию двусторонняя связь, что позволяет обновлять значение в TextBlock при изменении ползунка.
            ПРЕДСКАЗАНИЕ (2) растягиваешь окно по ширине — меняется ли (б)? Да, так как у TextBlock свойство ActualWidth OnWay по умолчанию, соответственно при изменении размера, обновится и наша цель.
            ПРЕДСКАЗАНИЕ (3) в разметке у окна Title="7.4 Биндинг". А раннер
            ПОСЛЕ создания окна ставит ему другой заголовок
            (видно в рамке окна при запуске). Что покажет (в)
            и почему? Покажет измененный заголовок окна, так изменилось свойство Title, а мы прявязались к нему и тут сработает обновление.
        -->
        <TabItem Header="1. Откуда источник">
            <StackPanel Margin="16">
                <Slider
                    x:Name="Volume"
                    Margin="0,0,0,12"
                    Maximum="100"
                    Minimum="0"
                    Value="25" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="(а) ползунок:  " />
                    <TextBlock
                        x:Name="SliderValue"
                        FontWeight="Bold"
                        Text="{Binding Value, ElementName=Volume}" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="(б) моя ширина:  " />
                </StackPanel>
                <TextBlock
                    x:Name="OwnWidth"
                    Background="#FFF3E6"
                    FontWeight="Bold"
                    Text="{Binding ActualWidth, ElementName=OwnWidth}" />

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="(в) заголовок окна:  " />
                    <TextBlock
                        x:Name="WindowTitle"
                        FontWeight="Bold"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!--
            ═══ ЗАДАЧА 2 (ПРОВОКАЦИОННАЯ): четыре режима ════════════════════
            Ползунок Level стартует с 10. Четыре поля связаны с ним
            ОДИНАКОВО, кроме режима. Триггер у всех — PropertyChanged,
            то есть ждать потери фокуса не нужно.
            
            Шаги — строго по порядку:
            шаг 0 — окно только открыли;
            шаг 1 — кнопка «Ползунок → 20»;
            шаг 2 — в поле TwoWay стёрли текст и набрали 30;
            шаг 3 — кнопка «Сброс», затем в поле OneWayToSource набрали 60.
            
            Внизу после каждой кнопки печатается значение ползунка.
            Правдоподобный ответ неверен минимум в трёх клетках.
            
            ПРЕДСКАЗАНИЕ — что в каждом поле и где ползунок:
            OneWay   TwoWay   OneTime   OneWayToSource   ползунок
            шаг 0 : OneWay 10   TwoWay 10   OneTime 10   OneWayToSource пусто   ползунок 10
            шаг 1 : OneWay 20  TwoWay 20  OneTime 10  OneWayToSource пусто  ползунок  20
            шаг 2 : OneWay 30  TwoWay 30  OneTime 10  OneWayToSource пусто  ползунок 30
            шаг 3 : OneWay 60  TwoWay 60  OneTime 10  OneWayToSource 60  ползунок 60
            
            ПРЕДСКАЗАНИЕ (5) в какой клетке уверенность ниже всего? 3
        -->
        <TabItem Header="2. Четыре режима">
            <DockPanel Margin="16">
                <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                    <Button
                        x:Name="LevelTo20Button"
                        Margin="0,0,8,8"
                        Padding="8,4"
                        Content="Ползунок → 20" />
                    <Button
                        x:Name="Reset2Button"
                        Margin="0,0,8,8"
                        Padding="8,4"
                        Content="Сброс" />
                </WrapPanel>

                <TextBlock
                    x:Name="Status2"
                    Margin="0,12,0,0"
                    DockPanel.Dock="Bottom"
                    Foreground="DimGray" />

                <StackPanel>
                    <Slider
                        x:Name="Level"
                        Margin="0,0,0,12"
                        Maximum="100"
                        Minimum="0"
                        Value="10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="OneWay" />
                        <TextBox
                            x:Name="OneWayBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,2"
                            Text="{Binding Value, ElementName=Level, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="TwoWay" />
                        <TextBox
                            x:Name="TwoWayBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,2"
                            Text="{Binding Value, ElementName=Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="OneTime" />
                        <TextBox
                            x:Name="OneTimeBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,2"
                            Text="{Binding Value, ElementName=Level, Mode=OneTime, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Text="OneWayToSource" />
                        <TextBox
                            x:Name="ToSourceBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,2"
                            Text="{Binding Value, ElementName=Level, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </TabItem>

        <!--
            ═══ ЗАДАЧА 3: когда значение уходит в объект ════════════════════
            DataContext этой вкладки — обычный объект Employee
            (Name = «Анна», Age = 30), выставлен в код-подложке. Сообщать
            об изменениях он НЕ умеет (как Person в 7.3).
            
            Два поля связаны с ОДНИМ И ТЕМ ЖЕ свойством Name:
            поле 1 — триггер по умолчанию;
            поле 2 — UpdateSourceTrigger=PropertyChanged.
            Третье поле — Age (int), тоже PropertyChanged.
            
            Обе кнопки НЕ забирают фокус при нажатии — как кнопки на панели
            инструментов. «Показать объект» печатает внизу, что реально
            лежит в объекте.
            
            Шаги — по порядку, ничего лишнего между ними не нажимать:
            (1) в поле 1 стёрли текст, набрали «Борис» и, НЕ уходя из поля,
            нажали «Показать объект»;
            (2) нажали Tab (фокус ушёл из поля 1), снова «Показать объект»;
            (3) в поле 2 стёрли текст и набрали «Глеб», «Показать объект»;
            (4) в поле возраста стёрли текст и набрали «abc», «Показать объект»;
            (5) нажали «Переименовать в коде» (в коде: employee.Name = "Вера"),
            затем «Показать объект».
            
            ПРЕДСКАЗАНИЕ — после каждого шага: что в объекте (Name, Age)
            и что видно в поле 1 и в поле 2:
            (1) : Name = «Анна», Age = 30; поле 1 = «Борис», поле 2 = «Анна»
            (2) : Name = «Борис», Age = 30; поле 1 = «Борис», поле 2 = «Борис»
            (3) : Name = «Глеб», Age = 30; поле 1 = «Глеб», поле 2 = «Глеб»
            (4) : Name = «Глеб», Age = 30; поле 1 = «Глеб», поле 2 = «Глеб» Вокруг возраста красная рамка. Исключения не будет.
            (5) : Name = «Вера», Age = 30; поле 1 = «Вера», поле 2 = «Вера»
            Поправка после запуска: (5) : Name = «Вера», Age = 30; поле 1 = «Глеб», поле 2 = «Глеб»
              Забыл, что у нас источником является обычный класс, а переименование мы сделали из кода.
              И класс ничего не умеет по умолчанию сообщать в интерфейс о своем изменении.
            
            ПРЕДСКАЗАНИЕ (6) подведи итог пяти шагам. В задаче значение может
            пройти тремя путями. Для каждого скажи: доходит или
            нет, и если доходит — в какой момент:
            (а) из поля на экране → в объект; доходит после потери фокуса.
            (б) из одного поля → в другое поле, связанное
            с тем же свойством объекта; доходит, после обновления значения
            (в) из кода (присваивание в объект) → в поля
            на экране. Не доходит.
            ПРЕДСКАЗАНИЕ (7) в каком шаге уверенность ниже всего? 5 и в нем я ошибся.
        -->
        <TabItem Header="3. Когда уходит в объект">
            <DockPanel x:Name="Root3" Margin="16">
                <WrapPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                    <Button
                        x:Name="ShowButton"
                        Margin="0,0,8,8"
                        Padding="8,4"
                        Content="Показать объект"
                        Focusable="False" />
                    <Button
                        x:Name="RenameButton"
                        Margin="0,0,8,8"
                        Padding="8,4"
                        Content="Переименовать в коде"
                        Focusable="False" />
                </WrapPanel>

                <TextBlock
                    x:Name="Status3"
                    Margin="0,12,0,0"
                    DockPanel.Dock="Bottom"
                    Foreground="DimGray" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Text="поле 1 (по умолчанию)" />
                    <TextBox
                        x:Name="NameDefault"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding Name}" />

                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="поле 2 (PropertyChanged)" />
                    <TextBox
                        x:Name="NameInstant"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Text="возраст (PropertyChanged)" />
                    <TextBox
                        x:Name="AgeBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </DockPanel>
        </TabItem>

    </TabControl>
</Window>
